{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",

  // Local model. Any Ollama model that supports tool calling works (qwen3:8b, llama3.1:8b, ...).
  "Ollama": { "Endpoint": "http://localhost:11434", "Model": "qwen3:8b" },

  // How the app launches the MCP server as a child process (stdio transport).
  // --no-build keeps `dotnet run` from printing build output to stdout (that would corrupt the protocol).
  "Mcp": { "Command": "dotnet", "Args": [ "run", "--project", "../PolicyMcpServer", "--no-build", "--no-launch-profile" ] }
}
